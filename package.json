{
  "name": "clawtifact",
  "version": "0.1.0",
  "type": "module",
  "description": "Single-browser Markdown and interactive HTML artifacts for OpenClaw, with on-demand Cloudflare links",
  "engines": {
    "node": ">=24"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.7",
      "minGatewayVersion": "2026.10.7"
    },
    "build": {
      "openclawVersion": "2026.10.7"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pengying/clawtifact.git"
  },
  "homepage": "https://github.com/pengying/clawtifact#readme",
  "bugs": {
    "url": "https://github.com/pengying/clawtifact/issues"
  },
  "files": [
    "index.js",
    "openclaw.plugin.json",
    "src/",
    "dist/",
    "README.md",
    "docs/security-review.md",
    "docs/verification.md"
  ]
}
